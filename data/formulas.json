  "law_kulon": [
    {
      "name": "\u0417\u0430\u043a\u043e\u043d \u041a\u0443\u043b\u043e\u043d\u0430",
      "formula_code": "F = k\\frac{\\left | q_1q_2 \\right |}{\\varepsilon_0 r^2}",
      "description": "\u0417\u0430\u043a\u043e\u043d \u041a\u0443\u043b\u043e\u043d\u0430 - \u0446\u0435 \u0444\u0456\u0437\u0438\u0447\u043d\u0438\u0439 \u0437\u0430\u043a\u043e\u043d, \u044f\u043a\u0438\u0439 \u043e\u043f\u0438\u0441\u0443\u0454 \u0441\u0438\u043b\u0443 \u0432\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u0457 \u043c\u0456\u0436 \u0434\u0432\u043e\u043c\u0430 \u043d\u0435\u0440\u0443\u0445\u043e\u043c\u0438\u043c\u0438 \u0442\u043e\u0447\u043a\u043e\u0432\u0438\u043c\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u043d\u0438\u043c\u0438 \u0437\u0430\u0440\u044f\u0434\u0430\u043c\u0438.\n\n\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f:\n\n\u0415\u043b\u0435\u043a\u0442\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u043d\u0430 \u0441\u0438\u043b\u0430 \u0432\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u0457 $F_{12}$ \u0434\u0432\u043e\u0445 \u0442\u043e\u0447\u043a\u043e\u0432\u0438\u0445 \u043d\u0435\u0440\u0443\u0445\u043e\u043c\u0438\u0445 \u0437\u0430\u0440\u044f\u0434\u0456\u0432 $q_1$ \u0442\u0430 $q_2$ \u0443 \u0432\u0430\u043a\u0443\u0443\u043c\u0456 \u043f\u0440\u044f\u043c\u043e \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0456\u0439\u043d\u0430 \u0434\u043e\u0431\u0443\u0442\u043a\u0443 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u0438\u0445 \u0437\u043d\u0430\u0447\u0435\u043d\u044c \u0437\u0430\u0440\u044f\u0434\u0456\u0432 \u0456 \u043e\u0431\u0435\u0440\u043d\u0435\u043d\u043e \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0456\u0439\u043d\u0430 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0443 \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u0456 $r_12$ \u043c\u0456\u0436 \u043d\u0438\u043c\u0438. \u041e\u0434\u043d\u043e\u0456\u043c\u0435\u043d\u043d\u0456 \u0437\u0430\u0440\u044f\u0434\u0438 \u0432\u0456\u0434\u0448\u0442\u043e\u0432\u0445\u0443\u044e\u0442\u044c\u0441\u044f, \u0430 \u0440\u0456\u0437\u043d\u043e\u0456\u043c\u0435\u043d\u043d\u0456 \u043f\u0440\u0438\u0442\u044f\u0433\u0443\u044e\u0442\u044c\u0441\u044f.\n\nF - \u0441\u0438\u043b\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u043d\u043e\u0457 \u0432\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u0457, \u0449\u043e \u0432\u0438\u043c\u0456\u0440\u044e\u0454\u0442\u044c\u0441\u044f \u0432 \u043d\u044c\u044e\u0442\u043e\u043d\u0430\u0445 (\u041d)\nr - \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u044c \u043c\u0456\u0436 \u0437\u0430\u0440\u044f\u0434\u0430\u043c\u0438, \u0449\u043e \u0432\u0438\u043c\u0456\u0440\u044e\u0454\u0442\u044c\u0441\u044f \u0432 \u043c\u0435\u0442\u0440\u0430\u0445 (\u043c)\n$q_1$ \u0438 $q_2$ - e\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u043d\u0456 \u0437\u0430\u0440\u044f\u0434\u0438, \u0432\u0438\u043c\u0456\u0440\u044e\u044e\u0442\u044c\u0441\u044f \u0432 \u043a\u0443\u043b\u043e\u043d\u0430\u0445 (\u041a\u043b)\nk - \u043a\u043e\u0435\u0444\u0456\u0446\u0456\u0454\u043d\u0442 \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456\nk = $\\frac{1}{4\\pi\\varepsilon_0}$ = 9 * 10\u2079 $\\frac{\u041d\u043c^2}{\u041a\u043b^2}$\n$\\varepsilon_0$ - \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u043d\u0430 \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u0430 \u0432\u0430\u043a\u043a\u0443\u043c\u0430\n$\\varepsilon_0$ \u2248 $8.85 * 10^{-12}$$\\frac{\u0424}{\u043c}$ \u0438\u043b\u0438 $\\frac{\u041a\u043b^2}{\u041d\u043c^2}$\n",
      "category": "\u0415\u043b\u0435\u043a\u0442\u0440\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u043d\u0435 \u043f\u043e\u043b\u0435 \u0443 \u0432\u0430\u043a\u0443\u0443\u043c\u0456",
      "tags": [
